ENVIRONMENT=production
NEON_DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars-long
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the free-tier model routing order (default: every free text model, best first).
# GEMINI_MODELS=["gemini-3.8-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"]
CORS_ORIGINS=["http://localhost:3000", "https://nexusagent.avinaba.com"]
# Number of trusted proxies in front of the API (Render = 1, Cloudflare + Render = 2).
TRUSTED_PROXY_HOPS=1
EMBEDDING_MODEL=gemini-embedding-001
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
